{
  "name": "pi-rpc-socket",
  "version": "0.2.0",
  "description": "Per-session RPC into a running Pi TUI: messages, explicit commands and correlated operation outcomes.",
  "main": "index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukastk/pi-rpc-socket.git"
  },
  "license": "MIT",
  "keywords": ["pi", "pi-extension", "pi-package", "coding-agent", "rpc", "unix-socket"],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
